POSTGRES_USER=teamreport
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=teamreport
DATABASE_URL=postgres://teamreport:change-me-strong@db:5432/teamreport
JWT_SECRET=replace-with-a-long-random-secret
VITE_API_BASE_URL=http://localhost:4000

# Chatbot: fully local rule-based assistant. No external LLM API keys required.
LLM_PROVIDER=local

# Echo chatbot model (local Ollama, not bundled). Run: ollama pull qwen3:1.7b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:1.7b
# URL the backend container uses to reach Ollama on the host
OLLAMA_DOCKER_URL=http://host.docker.internal:11434/api/generate
